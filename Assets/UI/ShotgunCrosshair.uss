.Crosshair {
    width: 50px;
    height: 50px;
    position: absolute;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    transform-origin: center;
    justify-content: center;
    align-items: center;
}

.Arc {
    position: absolute;
    width: 50px;
    height: 50px;
    left: auto;
    top: auto;
    border-width: 14px;
    border-color: white;
    border-radius: 50%;
    background-color: transparent;
    transform-origin: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.TopArc {
    rotate: 0;
    border-left-color: transparent;
    border-right-color: transparent;
    border-bottom-color: transparent;
    top: 0;
}

.RightArc {
    rotate: 90deg;
    border-left-color: transparent;
    border-right-color: transparent;
    border-bottom-color: transparent;
    right: 0;
}

.BottomArc {
    rotate: 180deg;
    border-left-color: transparent;
    border-right-color: transparent;
    border-bottom-color: transparent;
    bottom: 0;
}

.LeftArc {
    rotate: 270deg;
    border-left-color: transparent;
    border-right-color: transparent;
    border-bottom-color: transparent;
    left: 0;
}

.Center {
    position: absolute;
    width: 5px;
    height: 5px;
    left: auto;
    top: auto;
    border-width: 10px;
    border-color: white;
    border-radius: 50%;
    background-color: transparent;
    right: auto;
    bottom: auto;
    align-self: center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.CenterHole {
    position: absolute;
    width: 14px;
    height: 14px;
    left: 13px;
    top: 13px;
    background-color: black;
    border-radius: 50%;
}
