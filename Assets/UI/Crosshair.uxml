<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Frame" style="flex-grow: 1; left: 0; top: 0; right: 0; bottom: 0; align-content: center; align-self: auto; justify-content: center; align-items: center;">
        <ui:VisualElement name="Container" style="flex-grow: 1; width: 50px; height: 50px; position: absolute; justify-content: center; align-content: center; align-items: center;">
            <ui:VisualElement name="center" style="flex-grow: 1; position: absolute; -unity-background-image-tint-color: rgb(255, 255, 255); height: 4px; width: 4px; top: auto; left: auto; background-color: rgb(255, 0, 0); right: auto; bottom: auto; align-self: auto; align-content: auto; align-items: auto; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px;"/>
            <ui:VisualElement name="left" style="flex-grow: 1; position: absolute; -unity-background-image-tint-color: rgb(255, 255, 255); height: 2px; width: 10px; top: auto; left: 0; background-color: rgb(255, 0, 0); right: auto; bottom: auto; align-self: auto; align-content: auto; align-items: auto; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px;"/>
            <ui:VisualElement name="right" style="flex-grow: 1; position: absolute; -unity-background-image-tint-color: rgb(255, 255, 255); height: 2px; width: 10px; top: auto; left: auto; background-color: rgb(255, 0, 0); right: 0; bottom: auto; align-self: auto; align-content: auto; align-items: auto; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px;"/>
            <ui:VisualElement name="up" style="flex-grow: 1; position: absolute; -unity-background-image-tint-color: rgb(255, 255, 255); height: 10px; width: 2px; top: 0; left: auto; background-color: rgb(255, 0, 0); right: auto; bottom: auto; align-self: auto; align-content: auto; align-items: auto;"/>
            <ui:VisualElement name="down" style="flex-grow: 1; position: absolute; -unity-background-image-tint-color: rgb(255, 255, 255); height: 10px; width: 2px; top: auto; left: auto; background-color: rgb(255, 0, 0); right: auto; bottom: 0; align-self: auto; align-content: auto; align-items: auto;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
